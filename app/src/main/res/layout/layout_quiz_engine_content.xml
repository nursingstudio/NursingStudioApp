<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/app_background">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvQuizTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/test_series"
            android:textColor="@color/brand_blue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/_00_00"
            android:textColor="@color/brand_saffron_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnOpenPalette"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_grid_palette"
            app:tint="@color/text_primary"
            android:contentDescription="@string/open_palette" />
    </LinearLayout>

    <!-- Sub-Header View with Score Badges and Star Review Control -->
    <LinearLayout
        android:id="@+id/subHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:background="@color/surface_variant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvQuestionCounter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/question_1_100"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <!-- Score Indicators (Positive & Negative Markers) -->
        <TextView
            android:id="@+id/tvPositiveMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/badge_positive_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/positive_mark_val"
            android:textColor="@color/badge_positive_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNegativeMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            android:background="@color/badge_negative_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="@string/negative_mark_val"
            android:textColor="@color/badge_negative_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Interactive Review Star & Label -->
        <LinearLayout
            android:id="@+id/btnMarkForReview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ivReviewStar"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/star_mark"
                android:src="@drawable/ic_star"
                app:tint="@color/review_star_inactive" />

            <TextView
                android:id="@+id/tvReviewStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/mark_for_review"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Question Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/subHeader"
        android:layout_above="@+id/bottomBar"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Question Text with HTML Support -->
            <TextView
                android:id="@+id/tvQuestionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />

            <!-- Media Container Frame -->
            <FrameLayout
                android:id="@+id/frameMediaContainer"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivQuestionImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/image_placeholder"
                    android:src="@drawable/ic_placeholder_image" />

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerViewQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Dynamic Options View Container -->
            <RadioGroup
                android:id="@+id/rgOptionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Control Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="@color/surface_card"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:textSize="12sp"
            android:backgroundTint="@color/brand_saffron_dark"
            android:text="@string/btn_previous"
            android:textColor="@color/white"
            app:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearSelection"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:layout_marginHorizontal="4dp"
            android:paddingHorizontal="4dp"
            android:textSize="12sp"
            android:text="@string/btn_clear_response"
            android:textColor="@color/brand_saffron_dark"
            app:strokeColor="@color/brand_blue"
            app:strokeWidth="1.5dp"
            app:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="4dp"
            android:textSize="12sp"
            android:backgroundTint="@color/brand_blue"
            android:text="@string/btn_next"
            android:textColor="@color/white"
            app:textAllCaps="false" />
    </LinearLayout>

</RelativeLayout>