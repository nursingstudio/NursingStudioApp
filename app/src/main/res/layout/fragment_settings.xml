<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/settings"
            android:textColor="@color/brand_saffron_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSettingsSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="sans-serif"
            android:text="@string/customize_your_nursing_studio_experience"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            style="@style/Widget.App.TextView.SettingsCategoryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notifications"
            android:textColor="@color/brand_blue" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.CustomGlobalBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/brand_saffron_dark">

            <LinearLayout
                style="@style/Widget.App.SettingsRowContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/new_test_update_alerts"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:labelFor="@+id/switch_notifications" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_notifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/new_test_update_alerts"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.App.TextView.SettingsCategoryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/test_preferences"
            android:textColor="@color/brand_blue" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.CustomGlobalBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/brand_saffron_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Widget.App.SettingsRowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/sound_in_online_tests"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:labelFor="@+id/switch_quiz_sound" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_quiz_sound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/sound_in_online_tests"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/border_grey"
                    android:alpha="0.4" />

                <LinearLayout
                    style="@style/Widget.App.SettingsRowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/app_vibration"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:labelFor="@+id/switch_vibration" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_vibration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/app_vibration"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.App.TextView.SettingsCategoryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/security_settings"
            android:textColor="@color/brand_blue" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.CustomGlobalBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/brand_saffron_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/Widget.App.SettingsRowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/security_fallback_mpin"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:labelFor="@+id/switch_mpin" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_mpin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/security_fallback_mpin"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/border_grey"
                    android:alpha="0.4" />

                <LinearLayout
                    style="@style/Widget.App.SettingsRowContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/enable_biometric_login"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:labelFor="@+id/switch_unified_biometric" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_unified_biometric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/enable_biometric_login"
                        app:useMaterialThemeColors="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.App.TextView.SettingsCategoryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/motivation"
            android:textColor="@color/brand_blue" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.CustomGlobalBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/brand_saffron_dark">

            <LinearLayout
                style="@style/Widget.App.SettingsRowContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/show_motivational_quote_on_home"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:labelFor="@+id/switch_motivation" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_motivation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/show_motivational_quote_on_home"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.App.TextView.SettingsCategoryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/support_amp_info"
            android:textColor="@color/brand_blue" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.CustomGlobalBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/brand_saffron_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnRateApp"
                    style="@style/Widget.App.ActionRowRippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/rate_on_play_store"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    app:drawableEndCompat="@drawable/ic_chevron_right"
                    app:drawableTint="@color/medical_teal" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/border_grey"
                    android:alpha="0.4" />

                <TextView
                    android:id="@+id/btnWhatsappSupport"
                    style="@style/Widget.App.ActionRowRippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/need_help_contact_support"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    app:drawableEndCompat="@drawable/ic_chevron_right"
                    app:drawableTint="@color/medical_teal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Widget.App.TextView.SettingsCategoryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/legal_amp_app_information"
            android:textColor="@color/brand_blue" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.CustomGlobalBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/brand_saffron_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnPrivacyPolicy"
                    style="@style/Widget.App.ActionRowRippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/privacy_policy"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:drawableEndCompat="@drawable/ic_chevron_right"
                    app:drawableTint="@color/brand_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/border_grey"
                    android:alpha="0.3" />

                <TextView
                    android:id="@+id/btnTerms"
                    style="@style/Widget.App.ActionRowRippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/terms_of_use"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:drawableEndCompat="@drawable/ic_chevron_right"
                    app:drawableTint="@color/brand_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/border_grey"
                    android:alpha="0.3" />

                <TextView
                    android:id="@+id/btnDisclaimer"
                    style="@style/Widget.App.ActionRowRippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/disclaimer"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:drawableEndCompat="@drawable/ic_chevron_right"
                    app:drawableTint="@color/brand_blue" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/border_grey"
                    android:alpha="0.3" />

                <TextView
                    android:id="@+id/btnAbout"
                    style="@style/Widget.App.ActionRowRippleStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/about_nursing_studio"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:drawableEndCompat="@drawable/ic_chevron_right"
                    app:drawableTint="@color/brand_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>