<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="40dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imgHeaderProfile"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/ic_login_logo"
        app:civ_border_color="@color/brand_blue"
        app:civ_border_width="2.5dp" />

    <TextView
        android:id="@+id/tvHeaderName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/your_name"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="User" />

    <TextView
        android:id="@+id/tvHeaderMobile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:text="@string/_9999999999"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        tools:text="+9194xxxxxxxx" />

    <TextView
        android:id="@+id/tvUniqueNsId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:textColor="@color/brand_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="NS-2026-9481" />

    <TextView
        android:id="@+id/tvDrawerSubscription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_subscription_badge_token"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.04"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/brand_blue"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="PREMIUM" />

</LinearLayout>