<?xml version="1.0" encoding="utf-8"?>
<!-- 🚀 2026 Optimized Drawer Header Container -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="230dp"
    android:background="@color/surface_card"
    android:gravity="bottom|start"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="48dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imgHeaderProfile"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:src="@drawable/ic_login_logo"
        app:civ_border_color="@color/brand_blue"
        app:civ_border_width="2.5dp" />

    <TextView
        android:id="@+id/tvHeaderName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:text="@string/your_name"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHeaderMobile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:text="@string/_9999999999"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvDrawerSubscription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_subscription_badge_token"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.06"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@color/brand_blue"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>