<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTestItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/brand_saffron_dark">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layoutDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/ivLockStatus"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTestTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/full_syllabus_mock_test_1"
                android:textColor="@color/brand_blue"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTestSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/_100_questions_100_mins"
                android:textColor="@color/brand_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivLockStatus"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/lock_status"
            android:src="@drawable/ic_lock_open"
            app:tint="@color/brand_blue" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>