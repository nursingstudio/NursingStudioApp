<?xml version="1.0" encoding="utf-8"?>
<!-- Updated: fitsSystemWindows set to false for item layouts and added tools:ignore="EdgeToEdge" to resolve validator overlap issues -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:fitsSystemWindows="false"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/brand_saffron_dark"
    tools:ignore="EdgeToEdge">

    <TextView
        android:id="@+id/tvContentTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:text="@string/nursing_lecture_standard_title_slot"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:drawablePadding="16dp"
        app:drawableStartCompat="@drawable/ic_video_24"
        app:drawableTint="@color/brand_blue" />

</com.google.android.material.card.MaterialCardView>