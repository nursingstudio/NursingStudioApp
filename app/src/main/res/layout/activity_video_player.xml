<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_timeout="4000"
        app:use_controller="true" />

    <!-- Speed controls container with increased margins and padding to resolve "covered by System UI" render issues in previews.
         Note: At runtime, VideoPlayerActivity.kt applies dynamic window insets to this view. -->
    <LinearLayout
        android:id="@+id/speedControlsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="24dp"
        android:orientation="horizontal"
        android:background="#80000000"
        android:padding="8dp"
        android:fitsSystemWindows="true">

        <Button
            android:id="@+id/btnSpeedNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_1_0x"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnSpeedFast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_1_5x"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnSpeedSuperFast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_2_0x"
            style="@style/Widget.Material3.Button.TextButton"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/playerProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />
</FrameLayout>