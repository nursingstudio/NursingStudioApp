<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".ui.features.quiz.QuizEngineFragment">

    <!-- 🚀 2026 GOLD STANDARD: Header Card with Saffron Brand Stroke -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/brand_saffron"
        app:strokeWidth="1.5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvQuizTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/norcet_grand_test"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/timerContainer"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvSubjectTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/subject_anatomy"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvQuizTitle" />

            <LinearLayout
                android:id="@+id/timerContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/saffron_light"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/tvTimerClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/_00_00"
                    android:textColor="@color/error_red"
                    android:fontFamily="sans-serif-bold"
                    android:textSize="16sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Questions ViewPager2 Engine Container -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/quizViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/headerCard"
        app:layout_constraintBottom_toTopOf="@+id/footerNavigationPanel" />

    <!-- Footer Navigation Panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footerNavigationPanel"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/surface_card"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 🚀 2026 GOLD STANDARD: Outlined Button with Brand Saffron Border & Matching Accent Text -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPreviousQuestion"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/previous"
            android:textColor="@color/brand_saffron_dark"
            app:strokeColor="@color/brand_saffron"
            app:strokeWidth="1.5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tvQuestionProgressCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_1_of_100"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@id/btnPreviousQuestion"
            app:layout_constraintEnd_toStartOf="@+id/btnNextQuestion"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@string/next"
            android:backgroundTint="#0284C7"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>