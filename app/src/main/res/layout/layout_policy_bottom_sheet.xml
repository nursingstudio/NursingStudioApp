<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ NURSING STUDIO - PREMIUM SANITIZED BOTTOM SHEET (2026 GOLD STANDARD) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="14dp"
    android:paddingBottom="24dp">

    <!-- Premium Subdued Top Drag Handle Window Line -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@color/border_grey" />

    <!-- Main Section Header Title -->
    <TextView
        android:id="@+id/tvPolicyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/brand_saffron_dark"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/policy_title_tnc"/>

    <!-- ✅ EXACT LOCATION FIXED: Subtitle converted to Brand Blue for Premium Visual Hierarchy -->
    <TextView
        android:id="@+id/tvPolicySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:text=""
        android:textColor="@color/brand_blue"
        android:letterSpacing="0.06"
        android:layout_marginBottom="20dp"
        android:fontFamily="sans-serif-medium"/>

    <!-- Frictionless Fluid Core Scroll Layer -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:fadeScrollbars="false"
        android:scrollbarThumbVertical="@color/border_grey"
        android:scrollbars="vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvPolicyContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif" />
    </androidx.core.widget.NestedScrollView>

    <!-- ✅ EXACT LOCATION FIXED: Corporate High-Contrast Button with Saffron Dark & Dynamic Ripple -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAccept"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/policy_btn_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:enabled="false"
        android:alpha="0.5"
        app:backgroundTint="@color/brand_saffron_dark"
        app:rippleColor="@color/saffron_ripple"
        app:cornerRadius="14dp"
        app:elevation="2dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:fontFamily="sans-serif-medium"/>

</LinearLayout>