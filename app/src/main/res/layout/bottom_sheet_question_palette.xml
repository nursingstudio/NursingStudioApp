<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface_card"
    android:padding="16dp">

    <!-- BottomSheet Drag Handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@color/border_grey" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/question_palette"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-bold"
        android:textSize="18sp"
        android:layout_marginBottom="12dp" />

    <!-- Color Legend Status Indicators -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginBottom="16dp">

        <!-- Answered Legend -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">
            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@color/palette_answered" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/answered"
                android:textSize="12sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Skipped Legend -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">
            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@color/palette_skipped" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/skipped"
                android:textSize="12sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Unanswered Legend -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">
            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@color/palette_unanswered_border" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/unanswered"
                android:textSize="12sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Marked for Review Legend -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">
            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@color/palette_review" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/marked_for_review"
                android:textSize="12sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </GridLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_grey"
        android:layout_marginBottom="12dp" />

    <!-- Palette Grid RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQuestionGrid"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="5"
        tools:listitem="@layout/item_question_palette" />

</LinearLayout>