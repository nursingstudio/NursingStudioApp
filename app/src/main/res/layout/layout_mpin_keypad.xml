<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="@color/app_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enter_security_mpin"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/saffron_dark"/>

    <LinearLayout
        android:id="@+id/layoutMpinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="32dp">
        <View android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_margin="8dp"
            android:background="@drawable/mpin_dot_empty" />
        <View android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_margin="8dp"
            android:background="@drawable/mpin_dot_empty" />
        <View android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_margin="8dp"
            android:background="@drawable/mpin_dot_empty" />
        <View android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_margin="8dp"
            android:background="@drawable/mpin_dot_empty" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false">

        <com.google.android.material.button.MaterialButton android:id="@+id/btnKey1" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="1" android:textSize="24sp" android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnKey2" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="2" android:textSize="24sp" android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnKey3" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="3" android:textSize="24sp" android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnKey4" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="4" android:textSize="24sp" android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnKey5" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="5" android:textSize="24sp" android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnKey6" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="6" android:textSize="24sp" android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnKey7" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="7" android:textSize="24sp" android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnKey8" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="8" android:textSize="24sp" android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnKey9" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="9" android:textSize="24sp" android:textColor="@color/text_primary" />

        <View android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnKey0" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" android:text="0" android:textSize="24sp" android:textColor="@color/text_primary" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnKeyDel" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="0dp" android:layout_height="80dp" android:layout_columnWeight="1" app:icon="@drawable/ic_backspace" app:iconGravity="textStart" app:iconTint="@color/text_primary" />

    </GridLayout>

    <TextView
        android:id="@+id/btnForgotMpin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forgot_mpin"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="16dp" />
</LinearLayout>