<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="32dp"
    android:gravity="center_horizontal"
    android:clipToOutline="true"
    android:background="@drawable/bg_bottom_sheet">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enter_security_mpin"
        android:textColor="@color/brand_saffron_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:ignore="TextContrastCheck" />

    <LinearLayout
        android:id="@+id/layoutMpinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp">
        <View android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/mpin_dot_empty" />
        <View android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/mpin_dot_empty" />
        <View android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/mpin_dot_empty" />
        <View android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="10dp"
            android:background="@drawable/mpin_dot_empty" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        android:columnOrderPreserved="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey1"
            style="@style/MpinKeyStyle"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:text="@string/_1"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey2"
            style="@style/MpinKeyStyle"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:text="@string/_2"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey3"
            style="@style/MpinKeyStyle"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:text="@string/_3"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey4"
            style="@style/MpinKeyStyle"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:text="@string/_4"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey5"
            style="@style/MpinKeyStyle"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:text="@string/_5"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey6"
            style="@style/MpinKeyStyle"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:text="@string/_6"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey7"
            style="@style/MpinKeyStyle"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:text="@string/_7"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey8"
            style="@style/MpinKeyStyle"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:text="@string/_8"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey9"
            style="@style/MpinKeyStyle"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:text="@string/_9"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyBio"
            style="@style/MpinKeyStyle"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:padding="0dp"
            app:contentPadding="0dp"
            android:insetLeft="0dp"
            app:iconGravity="textStart"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/biometric_login_fingerprint"
            app:icon="@drawable/ic_fingerprint"
            app:iconSize="32dp"
            app:iconPadding="0dp"
            app:iconTint="@color/brand_saffron_dark"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKey0"
            style="@style/MpinKeyStyle"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:text="@string/_0"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeyDel"
            style="@style/MpinKeyStyle"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:padding="0dp"
            app:contentPadding="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/backspace"
            app:icon="@drawable/ic_backspace"
            app:iconGravity="textStart"
            app:iconSize="26dp"
            app:iconPadding="0dp"
            app:iconTint="@color/text_primary"
            app:strokeColor="@color/border_grey"
            app:strokeWidth="1dp" />

    </GridLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnForgotMpin"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:text="@string/forgot_mpin"
        android:textColor="@color/brand_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:strokeColor="@color/brand_saffron_dark"
        app:strokeWidth="1dp"
        app:cornerRadius="10dp"
        app:rippleColor="@color/saffron_ripple" />

</LinearLayout>