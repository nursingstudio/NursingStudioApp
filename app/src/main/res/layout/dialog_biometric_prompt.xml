<?xml version="1.0" encoding="utf-8"?>
<!-- ⭐ NURSING STUDIO - SANITIZED BIOMETRIC SECURE WINDOW (2026 COMPLIANT) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="24dp"
    android:gravity="center"
    android:background="@color/surface_card">

    <!-- Adaptive Top Icon Component -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/fingerprint_icon"
        android:src="@drawable/ic_fingerprint"
        app:tint="?attr/colorPrimary"
        tools:ignore="ImageContrastCheck" />

    <!-- Bold Title Layer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/unlock_with_biometrics"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="sans-serif-black"/>

    <!-- ✅ FIXED LINE 29: Sanitized hardcoded hex color to Semantic secondary system -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Enable_biometric_for_security"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.2"
        android:fontFamily="sans-serif"/>

    <!-- Primary Action: Setup Now Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSetupNow"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:text="@string/setup_secure_login"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="14dp"
        android:fontFamily="sans-serif-medium" />

    <!-- ✅ FIXED LINE 49: Maybe Later with 1dp Thin Saffron Dark Boundary and Unified Width Alignment -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLater"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="@string/maybe_later"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/brand_saffron_dark"
        app:strokeColor="@color/brand_saffron_dark"
        app:strokeWidth="1dp"
        app:cornerRadius="14dp"
        app:rippleColor="@color/saffron_ripple"
        android:fontFamily="sans-serif-medium" />

    <!-- ✅ FIXED LINE 61: Upgraded plain TextView to premium Outlined Action Component for structural symmetry -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNever"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:text="@string/don_t_ask_again"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/brand_blue"
        app:strokeColor="@color/brand_saffron_dark"
        app:strokeWidth="1dp"
        app:cornerRadius="14dp"
        app:rippleColor="@color/saffron_ripple"
        android:fontFamily="sans-serif-medium" />

</LinearLayout>