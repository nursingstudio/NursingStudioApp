<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="28dp"
    android:paddingBottom="28dp"
    android:gravity="center_horizontal"
    android:minWidth="360dp"
    android:background="@color/surface_card">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/imgFingerprintIndicator"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:contentDescription="@string/fingerprint_icon"
            android:src="@drawable/ic_fingerprint"
            app:tint="@color/brand_blue" />

        <ImageView
            android:id="@+id/imgFaceUnlockIndicator"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:contentDescription="@string/face_unlock_indicator"
            android:src="@drawable/ic_face_unlock"
            app:tint="@color/brand_saffron_dark" />

        <ImageView
            android:id="@+id/imgMpinIndicator"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:contentDescription="@string/mpin_security_indicator"
            android:src="@drawable/ic_lock"
            app:tint="@color/brand_blue" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_security_standard"
        android:textSize="19sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="?attr/colorOnSurface"
        android:fontFamily="sans-serif-black"/>

    <TextView
        android:id="@+id/tvSheetSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enable_fingerprint_face_unlock_or_secure_mpin_options_for_automated_1_tap_instant_validation"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.1"
        android:fontFamily="sans-serif"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSetupNow"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:text="@string/configure_security_credentials"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLater"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/maybe_later"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/brand_saffron_dark"
            app:strokeColor="@color/brand_blue"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:fontFamily="sans-serif-medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNever"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/don_t_ask_again"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/brand_blue"
            app:strokeColor="@color/brand_saffron_dark"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

</LinearLayout>