<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:background="@color/border_grey"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/verify_password_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/brand_saffron_dark"
        android:fontFamily="sans-serif-black" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/verify_password_subtitle"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:lineSpacingMultiplier="1.15"
        android:fontFamily="sans-serif" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilForgotMpinPassword"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/enter_account_password"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="@color/text_secondary"
        app:boxStrokeColor="@color/brand_blue"
        app:hintTextColor="@color/brand_blue"
        app:boxStrokeWidthFocused="2dp"
        app:errorTextAppearance="@style/TextAppearance.App.Error"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etForgotMpinPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif"
            android:imeOptions="actionDone"
            android:importantForAutofill="no" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerifyPasswordForMpinReset"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:text="@string/confirm_continue_action"
        android:textColor="@color/white"
        app:backgroundTint="@color/brand_blue"
        app:cornerRadius="12dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />
</LinearLayout>