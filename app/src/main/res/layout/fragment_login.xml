<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="40dp"
            android:paddingBottom="52dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:contentDescription="@string/nursing_studio_logo"
                android:scaleType="centerInside"
                android:src="@drawable/ic_login_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/app_name"
                android:textColor="@color/brand_saffron_dark"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgLogo" />

            <TextView
                android:id="@+id/tvAppTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.85"
                android:letterSpacing="0.06"
                android:text="@string/Tag_line"
                android:textColor="@color/brand_blue"
                android:textSize="13sp"
                android:textStyle="bold|italic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAppTitle" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loginCardView"
                style="@style/Widget.Material3.CardView.CustomGlobalBorder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAppTagline">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutDefaultForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilEmail"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/hint_email"
                            app:layout_constraintTop_toTopOf="parent"
                            app:startIconDrawable="@drawable/ic_email">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textEmailAddress" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilPassword"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="@string/hint_password"
                            app:layout_constraintTop_toBottomOf="@id/tilEmail"
                            app:passwordToggleEnabled="true"
                            app:startIconDrawable="@drawable/ic_lock">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLoginAction"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="20dp"
                            android:text="@string/btn_login"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp"
                            app:layout_constraintTop_toBottomOf="@id/tilPassword" />

                        <TextView
                            android:id="@+id/tvForgotPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/label_forgot_password"
                            android:textColor="@color/brand_saffron_dark"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/btnLoginAction" />

                        <TextView
                            android:id="@+id/tvGoRegister"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/label_go_register"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/btnLoginAction" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutAdaptiveMpinForm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="visible"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvWelcomeUser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/brand_blue"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="@string/welcome_back_user" />

                        <TextView
                            android:id="@+id/tvMpinSubtitlePrompt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="6dp"
                            android:alpha="0.80"
                            android:gravity="center"
                            android:textColor="@color/brand_saffron_dark"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvWelcomeUser"
                            tools:text="@string/choose_your_secure_method_below_to_proceed" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnMpinBoxTrigger"
                            style="@style/Widget.Material3.CardView.CustomGlobalBorder"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginTop="20dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@color/surface_card"
                            app:cardCornerRadius="12dp"
                            app:layout_constraintEnd_toStartOf="@id/btnBiometricBoxTrigger"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvMpinSubtitlePrompt"
                            app:strokeColor="@color/brand_blue"
                            app:strokeWidth="1.5dp">

                            <ImageView
                                android:id="@+id/imgMpinDotsCombined"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/dot"
                                android:padding="18dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_mpin_dots_four" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btnBiometricBoxTrigger"
                            style="@style/Widget.Material3.CardView.CustomGlobalBorder"
                            android:layout_width="0dp"
                            android:layout_height="60dp"
                            android:layout_marginStart="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@color/surface_card"
                            app:cardCornerRadius="12dp"
                            app:layout_constraintBottom_toBottomOf="@id/btnMpinBoxTrigger"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/btnMpinBoxTrigger"
                            app:layout_constraintTop_toTopOf="@id/btnMpinBoxTrigger"
                            app:strokeColor="@color/brand_saffron_dark"
                            app:strokeWidth="1.5dp">

                            <ImageView
                                android:id="@+id/imgCombinedBiometrics"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/biometrics"
                                android:padding="10dp"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_combined_biometrics"
                                app:tint="@color/brand_blue" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvForgotMpinAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/forgot_mpin"
                            android:textColor="@color/brand_saffron_dark"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/btnMpinBoxTrigger" />

                        <TextView
                            android:id="@+id/tvDifferentUser"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/different_user"
                            android:textColor="@color/brand_blue"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/btnMpinBoxTrigger" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPromoAdsContainer"
                style="@style/Widget.Material3.CardView.CustomGlobalBorder"
                android:layout_width="0dp"
                android:layout_height="236dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/loginCardView"
                app:strokeColor="@color/medical_teal"
                app:strokeWidth="1.5dp">

                <ViewFlipper
                    android:id="@+id/adViewFlipper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:animateFirstView="true">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutYoutubeAdClick"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:id="@+id/imgYtIconHeader"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="10dp"
                            android:contentDescription="@string/youtube_icon"
                            android:src="@drawable/ic_youtube"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvYtHeaderTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/subscribe_our_youtube_channel"
                            android:textColor="@color/brand_blue"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/tvYtHeaderAction"
                            app:layout_constraintStart_toEndOf="@id/imgYtIconHeader"
                            app:layout_constraintTop_toTopOf="@id/imgYtIconHeader" />

                        <TextView
                            android:id="@+id/tvYtHeaderHandle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/nursingstudio2026_yt_handle"
                            android:textColor="@color/brand_saffron_dark"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toStartOf="@id/tvYtHeaderAction"
                            app:layout_constraintStart_toStartOf="@id/tvYtHeaderTitle"
                            app:layout_constraintTop_toBottomOf="@id/tvYtHeaderTitle" />

                        <TextView
                            android:id="@+id/tvYtHeaderAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="14dp"
                            android:text="@string/subscribe_now"
                            android:textColor="@color/brand_youtube_red"
                            android:textSize="12sp"
                            android:textStyle="bold|italic"
                            app:layout_constraintBottom_toBottomOf="@id/imgYtIconHeader"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/imgYtIconHeader" />

                        <!-- ADDED: android:id="@+id/imgYtBanner" -->
                        <ImageView
                            android:id="@+id/imgYtBanner"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginTop="8dp"
                            android:contentDescription="@string/youtube_preview_showcase"
                            android:scaleType="fitXY"
                            android:src="@drawable/yt_snap"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/imgYtIconHeader" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layoutWhatsappAdClick"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:id="@+id/imgWaIconHeader"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="14dp"
                            android:layout_marginTop="10dp"
                            android:contentDescription="@string/whatsapp_icon"
                            android:src="@drawable/ic_whatsapp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvWaHeaderTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/join_our_whatsapp_channel"
                            android:textColor="@color/brand_blue"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@id/tvWaHeaderAction"
                            app:layout_constraintStart_toEndOf="@id/imgWaIconHeader"
                            app:layout_constraintTop_toTopOf="@id/imgWaIconHeader" />

                        <TextView
                            android:id="@+id/tvWaHeaderSubtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/get_instant_updates"
                            android:textColor="@color/brand_saffron_dark"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toStartOf="@id/tvWaHeaderAction"
                            app:layout_constraintStart_toStartOf="@id/tvWaHeaderTitle"
                            app:layout_constraintTop_toBottomOf="@id/tvWaHeaderTitle" />

                        <TextView
                            android:id="@+id/tvWaHeaderAction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="14dp"
                            android:text="@string/follow"
                            android:textColor="@color/brand_whatsapp_green"
                            android:textSize="12sp"
                            android:textStyle="bold|italic"
                            app:layout_constraintBottom_toBottomOf="@id/imgWaIconHeader"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/imgWaIconHeader" />

                        <!-- ADDED: android:id="@+id/imgWaBanner" -->
                        <ImageView
                            android:id="@+id/imgWaBanner"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginTop="8dp"
                            android:contentDescription="@string/whatsapp_stream_preview"
                            android:scaleType="fitXY"
                            android:src="@drawable/wa_snap"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/imgWaIconHeader" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </ViewFlipper>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvSecuredBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/secured_by"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardPromoAdsContainer" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <RelativeLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_black"
        android:elevation="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_centerInParent="true"
            android:indeterminateTint="@color/brand_saffron_dark" />
    </RelativeLayout>
</FrameLayout>