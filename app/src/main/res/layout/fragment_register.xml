<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/registrationScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background"
        android:fillViewport="true"
        android:scrollbars="none"
        android:isScrollContainer="true"
        android:overScrollMode="never"
        android:fitsSystemWindows="true"
        android:paddingTop="0dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="480dp"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="12dp">
            <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            android:layout_marginBottom="20dp">
                <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_create_account"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/saffron_dark"
            android:layout_marginBottom="2dp"/>

            <TextView style="@style/SectionHeaderStyle"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="@string/label_personal_details" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_full_name_req"
                app:helperTextEnabled="true"
                android:importantForAutofill="yes"
                app:cursorColor="@color/saffron"
                app:boxStrokeColor="@color/saffron"
                app:hintTextColor="@color/saffron"
                app:errorIconDrawable="@null">
                <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                    android:autofillHints="name"
                android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_gender_req"
                android:layout_marginTop="4dp"
                android:textStyle="bold"/>
            <Spinner android:id="@+id/spGender"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_bg"
                android:layout_marginTop="4dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDob"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/label_dob_req"
                app:helperTextEnabled="true"
                android:importantForAutofill="yes"
                app:errorIconDrawable="@null"
                app:cursorColor="@color/saffron"
                app:boxStrokeColor="@color/saffron"
                app:hintTextColor="@color/saffron"
                app:startIconDrawable="@android:drawable/ic_menu_my_calendar">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="Dob"
                    android:focusable="false"
                    android:clickable="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_marital_req"
                android:layout_marginTop="4dp"
                android:textStyle="bold"/>
            <Spinner android:id="@+id/spMarital"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_bg"/>

            <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_religion_req"
                android:layout_marginTop="4dp"
                android:textStyle="bold"/>
            <Spinner android:id="@+id/spReligion"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_bg"/>

            <TextView style="@style/SectionHeaderStyle"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="@string/label_occ_edu" />

            <Spinner android:id="@+id/spEducation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_bg"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEducationOther"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:helperTextEnabled="true"
                android:importantForAutofill="yes"
                app:errorIconDrawable="@null"
                app:cursorColor="@color/saffron"
                app:boxStrokeColor="@color/saffron"
                app:hintTextColor="@color/saffron"
                android:layout_marginTop="4dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEducationOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="education"
                    android:hint="@string/hint_spec_edu" />
            </com.google.android.material.textfield.TextInputLayout>

            <Spinner android:id="@+id/spOccupation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/spinner_bg"/>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOccupationOther"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:helperTextEnabled="true"
                android:importantForAutofill="yes"
                app:errorIconDrawable="@null"
                app:cursorColor="@color/saffron"
                app:boxStrokeColor="@color/saffron"
                app:hintTextColor="@color/saffron"
                android:layout_marginTop="4dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOccupationOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="occupation"
                    android:hint="@string/hint_spec_occ" />
            </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            style="@style/SectionHeaderStyle"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_contact_details"
                            android:layout_marginBottom="4dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:background="@drawable/spinner_bg"
                            android:gravity="center_vertical"
                            android:padding="2dp">

                            <com.hbb20.CountryCodePicker
                                android:id="@+id/ccp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:ccp_showNameCode="false"
                                app:ccp_autoFormatNumber="true"
                                app:ccp_hintExampleNumber="true"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="24dp"
                                android:background="#D1D1D1"
                                android:layout_marginEnd="8dp"/>

                            <EditText
                                android:id="@+id/etMobile"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="@string/hint_mobile_req"
                                android:inputType="number"
                                android:digits="0123456789"
                                android:maxLength="10"
                                android:background="@android:color/transparent"
                                android:textSize="16sp"
                                android:importantForAutofill="yes"
                                android:autofillHints="phoneNumberDevice" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvMobileError"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/design_default_color_error"
                            android:textSize="12sp"
                            android:visibility="gone"
                            android:layout_marginStart="4dp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:helperTextEnabled="true"
                android:importantForAutofill="yes"
                app:errorIconDrawable="@null"
                app:cursorColor="@color/saffron"
                app:boxStrokeColor="@color/saffron"
                app:hintTextColor="@color/saffron"
                android:hint="@string/hint_email_req">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:autofillHints="emailAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/SectionHeaderStyle"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="@string/label_address_details" />

            <Spinner android:id="@+id/spCountry"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/spinner_bg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCountryOther"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:helperTextEnabled="true"
                android:importantForAutofill="yes"
                app:errorIconDrawable="@null"
                app:cursorColor="@color/saffron"
                app:boxStrokeColor="@color/saffron"
                app:hintTextColor="@color/saffron"
                android:layout_marginTop="4dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCountryOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="country"
                    android:hint="@string/hint_country_req" />
            </com.google.android.material.textfield.TextInputLayout>

            <Spinner android:id="@+id/spStateIndia"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/spinner_bg"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStateOther"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:helperTextEnabled="true"
                android:importantForAutofill="yes"
                app:errorIconDrawable="@null"
                app:cursorColor="@color/saffron"
                app:boxStrokeColor="@color/saffron"
                app:hintTextColor="@color/saffron"
                android:layout_marginTop="4dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStateOther"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="state"
                    android:hint="@string/hint_state_req" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDistrict"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:helperTextEnabled="true"
                android:importantForAutofill="yes"
                app:errorIconDrawable="@null"
                app:cursorColor="@color/saffron"
                app:boxStrokeColor="@color/saffron"
                app:hintTextColor="@color/saffron"
                android:hint="@string/hint_district_req">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDistrict"
                    android:autofillHints="district"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAddress"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:helperTextEnabled="true"
                android:importantForAutofill="yes"
                app:errorIconDrawable="@null"
                app:cursorColor="@color/saffron"
                app:boxStrokeColor="@color/saffron"
                app:hintTextColor="@color/saffron"
                android:hint="@string/hint_address_req">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:autofillHints="address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:lines="3" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPincode"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:helperTextEnabled="true"
                android:importantForAutofill="yes"
                app:errorIconDrawable="@null"
                app:cursorColor="@color/saffron"
                app:boxStrokeColor="@color/saffron"
                app:hintTextColor="@color/saffron"
                android:hint="@string/hint_pincode_req">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPincode"
                    android:autofillHints="postalCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="6" />
            </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        style="@style/SectionHeaderStyle"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/label_nursing_reg_title" />

                    <RadioGroup
                        android:id="@+id/rgNursingReg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="-10dp"
                        android:layout_marginBottom="-8dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbRegYes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/yes"
                            android:textColor="@color/text_primary"
                            app:useMaterialThemeColors="true"
                            app:buttonTint="@color/saffron" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rbRegNo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/no"
                            android:textColor="@color/text_primary"
                            app:useMaterialThemeColors="true"
                            app:buttonTint="@color/saffron" />
                    </RadioGroup>

            <LinearLayout android:id="@+id/layoutRegDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="0dp">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegState"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:helperTextEnabled="true"
                    android:importantForAutofill="yes"
                    app:errorIconDrawable="@null"
                    app:cursorColor="@color/saffron"
                    app:boxStrokeColor="@color/saffron"
                    app:hintTextColor="@color/saffron"
                    android:hint="@string/hint_reg_state">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegState"
                        android:autofillHints="state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegNumber"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:helperTextEnabled="true"
                    android:importantForAutofill="yes"
                    app:errorIconDrawable="@null"
                    app:cursorColor="@color/saffron"
                    app:boxStrokeColor="@color/saffron"
                    app:hintTextColor="@color/saffron"
                    android:hint="@string/hint_reg_num">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegNumber"
                        android:autofillHints="registrationNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:helperTextEnabled="true"
                android:importantForAutofill="yes"
                app:errorIconDrawable="@null"
                app:cursorColor="@color/saffron"
                app:boxStrokeColor="@color/saffron"
                app:hintTextColor="@color/saffron"
                android:hint="@string/hint_set_pass"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/saffron">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:autofillHints="password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/layoutPasswordStrength"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone">

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/passwordStrengthProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:trackThickness="4dp"
                            app:trackCornerRadius="8dp"
                            android:progress="0"
                            app:indicatorColor="@color/saffron"
                            app:trackColor="#E0E0E0"/>

                        <TextView
                            android:id="@+id/tvStrengthLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weak"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_secondary"
                            android:textStyle="bold" />
                    </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingBottom="8dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="false"
                    android:layout_marginTop="0dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    app:buttonTint="@color/saffron" />

                <TextView
                    android:id="@+id/tvTermsLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/cbTerms"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4sp"
                    android:textColor="@color/text_secondary"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp" />
            </RelativeLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/btn_complete_reg"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/saffron_dark"
                app:cornerRadius="32dp"
                android:textSize="17sp"/>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                android:indeterminateTint="@color/saffron" />

        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/saffron"
            app:indicatorSize="64dp"
            app:trackThickness="6dp" />
    </FrameLayout>
</FrameLayout>