<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.CustomGlobalBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/brand_saffron_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <FrameLayout
                    android:id="@+id/layoutProfileAvatarContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/profile_image"
                    android:background="?attr/selectableItemBackgroundBorderless">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/imgHeaderProfile"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:src="@drawable/ic_login_logo"
                        app:civ_border_color="@color/brand_blue"
                        app:civ_border_width="2dp" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:importantForAccessibility="no"
                        android:clickable="false"
                        android:focusable="false"
                        app:fabCustomSize="36dp"
                        app:fabSize="mini"
                        app:srcCompat="@android:drawable/ic_menu_camera"
                        app:backgroundTint="@color/brand_blue"
                        app:tint="@color/white" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Scholar Name" />

                <TextView
                    android:id="@+id/tvUniqueNsId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:textColor="@color/brand_blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="NS-2026-9481" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        tools:text="user@nursingstudio.com" />

                    <TextView
                        android:id="@+id/tvEmailBadgeStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:background="@android:color/transparent"
                        tools:text="Not Verified" />

                    <TextView
                        android:id="@+id/btnVerifyNowAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-bold"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/medical_teal"
                        android:text="@string/verify_now"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.CustomGlobalBorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/brand_saffron_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_personal_info"
                    android:textColor="@color/brand_saffron_dark"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:letterSpacing="0.03" />

                <include android:id="@+id/rowGender" layout="@layout/item_profile_detail" />
                <include android:id="@+id/rowDob" layout="@layout/item_profile_detail" />
                <include android:id="@+id/rowMarital" layout="@layout/item_profile_detail" />
                <include android:id="@+id/rowReligion" layout="@layout/item_profile_detail" />
                <include android:id="@+id/rowMobile" layout="@layout/item_profile_detail" />
                <include android:id="@+id/rowEducation" layout="@layout/item_profile_detail" />
                <include android:id="@+id/rowOccupation" layout="@layout/item_profile_detail" />
                <include android:id="@+id/rowAddress" layout="@layout/item_profile_detail" />

                <View
                    android:id="@+id/dividerNursing"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/border_grey"
                    android:alpha="0.4" />

                <LinearLayout
                    android:id="@+id/layoutNursingRegistrationSubsuite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/tvNursingStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Nursing Registered: Yes" />

                    <include android:id="@+id/rowNursingState" layout="@layout/item_profile_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
                    <include android:id="@+id/rowNursingNo" layout="@layout/item_profile_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_logout"
            android:textColor="@color/brand_saffron_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_gravity="center"
            app:icon="@drawable/ic_power_logout"
            app:iconSize="24dp"
            app:iconPadding="12dp"
            app:iconGravity="textStart"
            app:iconTint="@color/brand_saffron_dark"
            app:strokeColor="@color/brand_blue"
            app:strokeWidth="1.5dp"
            app:cornerRadius="12dp"
            app:rippleColor="@color/saffron_ripple" />
    </LinearLayout>
</ScrollView>