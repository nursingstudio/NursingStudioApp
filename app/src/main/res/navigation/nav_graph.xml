<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_home">

    <!-- Home Fragment -->
    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.nursingstudio.ui.features.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <!-- Quiz Categories Fragment -->
    <fragment
        android:id="@+id/nav_quiz"
        android:name="com.example.nursingstudio.ui.features.quiz.QuizFragment"
        android:label="Quiz Categories"
        tools:layout="@layout/fragment_quiz">
        <action
            android:id="@+id/action_nav_quiz_to_nav_test_list"
            app:destination="@id/nav_test_list"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Test List Fragment -->
    <fragment
        android:id="@+id/nav_test_list"
        android:name="com.example.nursingstudio.ui.features.quiz.TestListFragment"
        android:label="Available Tests"
        tools:layout="@layout/fragment_test_list">
        <argument
            android:name="category_id"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <!-- Media Features -->
    <fragment
        android:id="@+id/nav_pdf"
        android:name="com.example.nursingstudio.ui.features.media.PdfFragment"
        android:label="Study Material" />

    <fragment
        android:id="@+id/nav_video"
        android:name="com.example.nursingstudio.ui.features.media.VideoFragment"
        android:label="Video Lectures" />

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.example.nursingstudio.ui.features.profile.ProfileFragment"
        android:label="My Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/nav_subscription"
        android:name="com.example.nursingstudio.ui.features.subscriptions.SubscriptionFragment"
        android:label="Subscriptions" />

    <fragment
        android:id="@+id/nav_notice"
        android:name="com.example.nursingstudio.ui.features.notifications.NoticeFragment"
        android:label="Notifications" />

    <fragment
        android:id="@+id/nav_social_fragment"
        android:name="com.example.nursingstudio.ui.features.social.SocialHandlesFragment"
        android:label="Social Media" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="com.example.nursingstudio.ui.features.settings.SettingsFragment"
        android:label="Settings" />

    <fragment
        android:id="@+id/nav_static_page"
        android:name="com.example.nursingstudio.ui.features.staticpage.StaticPageFragment"
        android:label="Static Page" />

    <!-- Auth Destinations -->
    <fragment
        android:id="@+id/nav_login"
        android:name="com.example.nursingstudio.ui.features.auth.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_nav_login_to_nav_register"
            app:destination="@id/nav_register"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left" />
    </fragment>

    <fragment
        android:id="@+id/nav_register"
        android:name="com.example.nursingstudio.ui.features.auth.register.RegisterFragment"
        android:label="Create Account"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_nav_register_to_nav_login"
            app:destination="@id/nav_login"
            app:popUpTo="@id/nav_login"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>