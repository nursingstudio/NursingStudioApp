<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme: LIGHT ONLY -->
    <style name="Base.Theme.NursingStudio" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary saffron -->
        <item name="colorPrimary">@color/saffron</item>
        <item name="colorPrimaryContainer">@color/saffron</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Status & nav bar -->
        <item name="android:statusBarColor">@color/saffron_dark</item>
        <item name="android:navigationBarColor">@color/saffron_dark</item>

        <!-- App background -->
        <item name="android:colorBackground">@color/app_background</item>

        <!-- Global text colors (MyPage / Drawer / etc.) -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <style name="Theme.NursingStudio" parent="Base.Theme.NursingStudio" />

    <!-- Toolbar title bold style -->
    <style name="ToolbarTitleBold"
        parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>



</resources>
