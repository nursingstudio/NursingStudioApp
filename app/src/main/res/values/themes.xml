<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NursingStudio" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_saffron</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/medical_teal</item>

        <item name="android:windowBackground">@color/app_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="colorControlNormal">@color/text_secondary</item>
        <item name="colorControlActivated">@color/brand_blue</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="colorError">@color/error_red</item>
        <item name="colorOnError">@color/white</item>
        <item name="android:textColorHighlight">@color/saffron_light</item>

        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox.CustomGlobal</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialogTheme</item>

        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Widget.Material3.TextInputLayout.OutlinedBox.CustomGlobal" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/brand_blue</item> <item name="boxStrokeWidthFocused">2dp</item>
        <item name="cursorColor">@color/brand_blue</item>
        <item name="passwordToggleTint">@color/text_secondary</item>
        <item name="hintTextColor">@color/brand_blue</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Card.Rounded</item>
    </style>

    <style name="TextAppearance.App.Error" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/error_red</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.NursingStudio.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="SectionHeaderStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/brand_saffron_dark</item>
    </style>

    <style name="ToolbarTitleBold">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CustomMaterialCalendar" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/brand_saffron_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSecondary">@color/brand_blue</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="colorSecondaryContainer">@color/brand_saffron_dark</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface_card</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Card.Rounded</item>
        <item name="behavior_peekHeight">auto</item>
        <item name="enableEdgeToEdge">true</item>
    </style>

    <style name="MaterialAlertDialog_Rounded" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Card.Rounded</item>
        <item name="colorPrimary">@color/brand_saffron_dark</item>
        <item name="buttonBarPositiveButtonStyle">@style/SaffronButtonStyle</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.65</item>
        <item name="colorSurface">@color/surface_card</item>
    </style>

    <style name="SaffronButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/brand_saffron_dark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Card.Rounded" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="MpinKeyStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/saffron_light</item>
        <item name="shapeAppearanceOverlay">@style/CircleAppearance</item>
    </style>

    <style name="CircleAppearance" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <style name="GlassBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/GlassBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="GlassBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>