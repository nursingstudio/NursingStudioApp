<resources xmlns:tools="http://schemas.android.com/tools">


    <style name="Theme.NursingStudio.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
    </style>

    <style name="SectionHeaderStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/saffron_dark</item>
    </style>

    <style name="ToolbarTitleBold">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Theme.NursingStudio" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/saffron</item>
        <item name="colorSecondary">@color/saffron</item>
        <item name="android:listChoiceIndicatorSingle">@color/saffron</item>
        <item name="colorControlActivated">@color/saffron</item>
        <item name="colorAccent">@color/saffron</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSelectHandle">@null</item>
        <item name="android:textSelectHandleLeft">@null</item>
        <item name="android:textSelectHandleRight">@null</item>
        <item name="colorTertiary">@color/saffron_dark</item>
        <item name="colorPrimaryContainer">@color/app_background</item>
        <item name="colorOnPrimaryContainer">@color/saffron_dark</item>
        <item name="android:datePickerStyle">@style/CustomDatePicker</item>

        // before splash, added these lines.... start //
        <item name="colorControlNormal">#757575</item>
        <item name="android:statusBarColor">#FFD580</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorOnSurfaceVariant">#555555</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">#757575</item>
        // before splash, added these lines.... end //



    </style>

    <style name="CustomDatePicker" parent="android:Widget.Material.Light.DatePicker">
        <item name="android:headerBackground">@color/saffron</item>
        <item name="android:dayOfWeekBackground">@color/saffron_dark</item>
    </style>

    <style name="CustomMaterialCalendar" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/saffron</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSecondary">@color/saffron_dark</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>