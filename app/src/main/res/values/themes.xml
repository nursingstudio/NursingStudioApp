<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.NursingStudio" parent="Base.Theme.NursingStudio" />

    <!-- Base application theme (Light / default) -->
    <style name="Base.Theme.NursingStudio" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary saffron -->
        <item name="colorPrimary">@color/saffron</item>
        <item name="colorPrimaryContainer">@color/saffron</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- Status & nav bar -->
        <item name="android:statusBarColor">@color/saffron_dark</item>
        <item name="android:navigationBarColor">@color/saffron_dark</item>

        <!-- App background -->
        <item name="android:colorBackground">@color/app_background</item>

        <!-- Dark mode force off -->
        <item name="android:forceDarkAllowed">false</item>

    </style>


    <!-- Agar kabhi UCrop wapas use karna ho to ye rehne do -->
    <style name="UCropActivityTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/saffron</item>
        <item name="colorPrimaryDark">@color/saffron_dark</item>
        <item name="colorAccent">@android:color/white</item>
        <item name="android:navigationBarColor">@color/saffron</item>
    </style>

    <style name="ToolbarTitleBold" parent="@style/TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

</resources>
