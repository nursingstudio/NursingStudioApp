<resources xmlns:tools="http://schemas.android.com/tools">

    // main theme //
    <style name="Theme.NursingStudio" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/saffron</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorOnSurface">#444444</item>
        <item name="colorOnSurfaceVariant">#757575</item>

        <item name="colorControlNormal">#757575</item>
        <item name="colorControlActivated">@color/saffron</item>

        <item name="android:windowBackground">@color/app_background</item>

        <item name="android:textColorHighlight">#4DFFD580</item>

        <item name="android:windowDisablePreview">true</item>

    </style>

// splash screen theme //
    <style name="Theme.NursingStudio.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">#000000</item>

        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>

        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>

        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    // section header //
    <style name="SectionHeaderStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/saffron_dark</item>
    </style>

    // toolbar title //
    <style name="ToolbarTitleBold">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    // date picker //
    <style name="CustomDatePicker" parent="android:Widget.Material.Light.DatePicker">
        <item name="android:headerBackground">@color/saffron</item>
        <item name="android:dayOfWeekBackground">@color/saffron_dark</item>
    </style>

    // calendar //
    <style name="CustomMaterialCalendar" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/saffron</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSecondary">@color/saffron_dark</item>
    </style>

    // bottom sheet //
    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    // MaterialAlertDialog //
    <style name="MaterialAlertDialog_Rounded" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Card.Rounded</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Card.Rounded" parent="">
        <item name="cornerSize">24dp</item>
    </style>

    // MPIN //
    <style name="MpinKeyStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="rippleColor">@color/saffron_light</item> <item name="shapeAppearanceOverlay">@style/CircleAppearance</item> </style>

    <style name="CircleAppearance">
        <item name="cornerSize">50%</item>
    </style>

    <style name="GlassBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/GlassBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="GlassBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>


</resources>