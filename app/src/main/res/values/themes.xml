<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.NursingStudio" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/saffron</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/saffron_light</item>

        <item name="colorSecondary">@color/saffron</item>
        <item name="colorTertiary">@color/saffron_dark</item>
        <item name="colorAccent">@color/saffron</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <item name="colorControlActivated">@color/saffron</item>
        <item name="colorControlNormal">@color/text_secondary</item>

        <item name="android:statusBarColor">@color/saffron_dark</item>
        <item name="android:navigationBarColor">@color/saffron_dark</item>
        <item name="android:colorBackground">@color/app_background</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorLink">@color/saffron</item>
    </style>

    <style name="Theme.NursingStudio" parent="Base.Theme.NursingStudio" />

    <style name="Theme.NursingStudio.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
    </style>

    <style name="SaffronRadioStyle" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:buttonTint">@color/saffron</item>
        <item name="colorControlNormal">@color/saffron</item>
        <item name="colorControlActivated">@color/saffron</item>
    </style>

    <style name="SectionHeaderStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/saffron_dark</item>
    </style>

    <style name="ToolbarTitleBold">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item> <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>